diff --git a/basic_framework/stdin_io.py b/basic_framework/stdin_io.py
new file mode 100644
index 0000000..1126567
--- /dev/null
+++ b/basic_framework/stdin_io.py
@@ -0,0 +1,165 @@
+# histra: stdin/stdout adaptation, as for Refactory. Brafar repairs functions and tests `result = <call>`, so a raw
+# program is written as `def stdin_main(): <program>`, and run() executes it on fd 0 after its question's imports.
+import ast
+import builtins
+import functools
+import io
+import os
+import sys
+
+ENTRY = "stdin_main"
+END_CODE = ENTRY + "()\n"
+TIMEOUT = float(os.environ.get("BRAFAR_TO", 2))        # the problem's time limit (set by the driver)
+FL_TIMEOUT = float(os.environ.get("BRAFAR_FL_TO", 0.1))  # one fault-localization trace run; bounds the trace log
+
+
+def wrap(code):
+    """Raw program -> `def stdin_main(): ...`; unparseable code is returned unchanged."""
+    try:
+        m = ast.parse(code)
+    except SyntaxError:
+        return code
+    imps = [n for n in m.body if isinstance(n, (ast.Import, ast.ImportFrom))]
+    fn = ast.parse("def " + ENTRY + "():\n    pass").body[0]
+    fn.body = [n for n in m.body if n not in imps] or fn.body
+    return ast.unparse(ast.Module(imps + [fn], []))
+
+
+def imports(code):
+    try:
+        return [ast.unparse(n) for n in ast.walk(ast.parse(code)) if isinstance(n, (ast.Import, ast.ImportFrom))]
+    except SyntaxError:
+        return []
+
+
+def bound(imp):
+    return {a.asname or a.name.split(".")[0] for a in ast.parse(imp).body[0].names}
+
+
+def ques_imports(ques_dir_path):
+    """Import statements of all programs of a question (reference, correct, wrong), deduplicated in file order."""
+    out = []
+    for sub in ("reference", "correct", "wrong"):
+        d = os.path.join(ques_dir_path, "code", sub)
+        for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
+            with open(os.path.join(d, name), "r") as f:
+                out.extend(imports(f.read()))
+    return list(dict.fromkeys(out))
+
+
+TRACE_VARS = "__histra_trace_vars"
+TRACE_DEF = f"""
+def {TRACE_VARS}(env):
+    import math
+    def plain(v, depth=0):
+        if v is None or isinstance(v, (bool, int, str)):
+            return True
+        if isinstance(v, float):
+            return math.isfinite(v)
+        if depth < 3 and isinstance(v, (list, tuple, set)):
+            return all(plain(x, depth + 1) for x in v)
+        if depth < 3 and isinstance(v, dict):
+            return all(plain(k, depth + 1) and plain(x, depth + 1) for k, x in v.items())
+        return False
+    return {{k: v for k, v in env.items() if plain(v)}}
+"""
+
+
+@functools.lru_cache(maxsize=None)
+def front_code(ques_dir_path):
+    # TRACE_DEF: trace holes print locals() and eval() them back, which fails on the callables, modules and files that
+    # stdin programs keep in locals (e.g., `input = sys.stdin.readline`)
+    return "\n".join(['__name__ = "__main__"'] + ques_imports(ques_dir_path)) + "\n" + TRACE_DEF + "\n"
+
+
+def unwrap(rep_code, ques_dir_path, bug_file_name):
+    """Repaired `def stdin_main(): ...` -> stdin/stdout program: its body under the imports it needs."""
+    fn = ast.parse(rep_code).body[0]
+    assert isinstance(fn, ast.FunctionDef) and fn.name == ENTRY, rep_code[:80]
+    body = ast.unparse(ast.Module(fn.body, []))
+    with open(os.path.join(ques_dir_path, "code", "wrong", bug_file_name), "r") as f:
+        own = imports(f.read())
+    union = ques_imports(ques_dir_path)
+    tree = ast.parse(body)
+    used = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name)} - set().union(*map(bound, own))
+    need = own + [i for i in union if i not in own and bound(i) & used]
+    defined = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name) and not isinstance(n.ctx, ast.Load)}
+    defined |= {a.arg for a in ast.walk(tree) if isinstance(a, ast.arg)} | set(dir(builtins))
+    if used - defined - set().union(*map(bound, need)):
+        need += [i for i in union if i not in need and "*" in bound(i)]
+    return "\n".join(need + [body])
+
+
+def set_stdin(text):
+    """Serve `text` as fd 0 (sys.stdin, input(), sys.stdin.buffer, open(0)) of the next run."""
+    import tempfile
+    try:
+        os.fstat(0)
+    except OSError:  # a program's open(0) closed fd 0: occupy it so the temp file gets another descriptor
+        os.open(os.devnull, os.O_RDONLY)
+    with tempfile.TemporaryFile() as f:
+        f.write(text.encode())
+        f.seek(0)
+        os.dup2(f.fileno(), 0)
+    sys.stdin = io.open(0, closefd=False)
+
+
+def run(code, input_path, output_path, sec):
+    """True iff the program exits normally within `sec` with the expected output. Exceptions propagate as in the
+    released run_tc; a timeout is also marked on stderr (`histra:timeout:test|fl`), as its outcome depends on load."""
+    from timeout_decorator import timeout, TimeoutError as Timeout
+    with open(input_path, "r") as f:
+        set_stdin(f.read())
+    with open(output_path, "r") as f:
+        exp = f.read().split()
+    t_code = front_code(os.path.dirname(os.path.dirname(input_path))) + code + "\n" + END_CODE
+    outer, buf, ok = sys.stdout, io.StringIO(), True
+    sys.stdout = buf
+    try:
+        timeout(sec)(exec)(t_code, {})
+    except SystemExit as e:  # exit()/sys.exit() ends a stdin program; only a nonzero code is an error
+        ok = e.code in (None, 0)
+    except Timeout:
+        print("histra:timeout:" + ("fl" if sec == FL_TIMEOUT else "test"), file=sys.__stderr__, flush=True)
+        raise
+    finally:
+        sys.stdout = outer
+        if outer is not sys.__stdout__:
+            outer.write(buf.getvalue())
+    return ok and buf.getvalue().split() == exp
+
+
+if __name__ == "__main__":  # check: python -m basic_framework.stdin_io (from baselines/brafar)
+    import tempfile
+    d = tempfile.mkdtemp()
+    for sub in ("ans", "code/wrong"):
+        os.makedirs(os.path.join(d, sub))
+    open(f"{d}/ans/input_0.txt", "w").write("3\n1 2 3\n")
+    open(f"{d}/ans/output_0.txt", "w").write("6\n")
+    src = "import sys\ninput = sys.stdin.readline\nn = int(input())\nprint(sum(map(int, input().split())))\nexit()"
+    w = wrap(src)
+    open(f"{d}/code/wrong/buggy.py", "w").write(w)
+    assert run(w, f"{d}/ans/input_0.txt", f"{d}/ans/output_0.txt", 2)
+    assert not run(w.replace("sum(", "max("), f"{d}/ans/input_0.txt", f"{d}/ans/output_0.txt", 2)
+    sys.stdout = log = io.StringIO()  # a trace run
+    try:
+        traced = w.replace("print(sum", f"print('block0:', {TRACE_VARS}(locals()))\n    print(sum")
+        run(traced, f"{d}/ans/input_0.txt", f"{d}/ans/output_0.txt", 2)  # fails: the trace lines are output too
+    finally:
+        sys.stdout = sys.__stdout__
+    assert eval(log.getvalue().splitlines()[0].split(" ", 1)[1]) == {"n": 3}, log.getvalue()
+    import contextlib
+    err = io.StringIO()
+    with contextlib.redirect_stderr(err):
+        sys.__stderr__, real = err, sys.__stderr__
+        try:
+            run(wrap("while True:\n    pass"), f"{d}/ans/input_0.txt", f"{d}/ans/output_0.txt", 0.2)
+            raise AssertionError("no timeout")
+        except Exception as e:
+            assert type(e).__name__ == "TimeoutError", e
+        finally:
+            sys.__stderr__ = real
+    assert err.getvalue().strip() == "histra:timeout:test", err.getvalue()
+    fn = ast.unparse(ast.parse(w).body[-1])  # Brafar returns the repaired function only
+    assert unwrap(fn, d, "buggy.py").startswith("import sys\ninput = sys.stdin.readline")
+    print("ok")
