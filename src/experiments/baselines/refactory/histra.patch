diff --git a/basic_framework/stdin_io.py b/basic_framework/stdin_io.py
new file mode 100644
index 0000000..b2d7dd2
--- /dev/null
+++ b/basic_framework/stdin_io.py
@@ -0,0 +1,64 @@
+# histra: stdin/stdout adaptation. Refactory repairs functions (regularize() drops top-level code and imports), so a raw
+# program runs as `def stdin_main(): <program>` after its question's imports and is unwrapped after repair.
+import ast
+import builtins
+import os
+
+ENTRY = "stdin_main"
+END_CODE = ENTRY + "()\n"
+
+
+def wrap(code):
+    """Raw program -> `def stdin_main(): ...`; unparseable code is returned unchanged (syntax_check then skips it)."""
+    try:
+        m = ast.parse(code)
+    except SyntaxError:
+        return code
+    imps = [n for n in m.body if isinstance(n, (ast.Import, ast.ImportFrom))]
+    fn = ast.parse("def " + ENTRY + "():\n    pass").body[0]
+    fn.body = [n for n in m.body if n not in imps] or fn.body
+    return ast.unparse(ast.Module(imps + [fn], []))
+
+
+def imports(code):
+    try:
+        return [ast.unparse(n) for n in ast.walk(ast.parse(code)) if isinstance(n, (ast.Import, ast.ImportFrom))]
+    except SyntaxError:
+        return []
+
+
+def bound(imp):
+    return {a.asname or a.name.split(".")[0] for a in ast.parse(imp).body[0].names}
+
+
+def ques_imports(ques_dir_path):
+    """Import statements of all programs of a question (reference, correct, wrong), deduplicated in file order."""
+    out = []
+    for sub in ("reference", "correct", "wrong"):
+        d = os.path.join(ques_dir_path, "code", sub)
+        for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
+            with open(os.path.join(d, name), "r") as f:
+                out.extend(imports(f.read()))
+    return list(dict.fromkeys(out))
+
+
+def front_code(ques_dir_path):
+    return "\n".join(['__name__ = "__main__"'] + ques_imports(ques_dir_path)) + "\n"
+
+
+def unwrap(rep_code, ques_dir_path, bug_file_name):
+    """Repaired `def stdin_main(): ...` -> stdin/stdout program: its body under the imports it needs."""
+    fn = ast.parse(rep_code).body[0]
+    assert isinstance(fn, ast.FunctionDef) and fn.name == ENTRY, rep_code[:80]
+    body = ast.unparse(ast.Module(fn.body, []))
+    with open(os.path.join(ques_dir_path, "code", "wrong", bug_file_name), "r") as f:
+        own = imports(f.read())
+    union = ques_imports(ques_dir_path)
+    tree = ast.parse(body)
+    used = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name)} - set().union(*map(bound, own))
+    need = own + [i for i in union if i not in own and bound(i) & used]
+    defined = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name) and not isinstance(n.ctx, ast.Load)}
+    defined |= {a.arg for a in ast.walk(tree) if isinstance(a, ast.arg)} | set(dir(builtins))
+    if used - defined - set().union(*map(bound, need)):
+        need += [i for i in union if i not in need and "*" in bound(i)]
+    return "\n".join(need + [body])
